{
    "name": "prodstarter/filament-forge-insights",
    "description": "This is my package filament-forge-insights",
    "keywords": [
        "prodstarter",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-forge-insights"
    ],
    "homepage": "https://github.com/prodstarter/filament-forge-insights",
    "support": {
        "issues": "https://github.com/prodstarter/filament-forge-insights/issues",
        "source": "https://github.com/prodstarter/filament-forge-insights"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Stanley Ojadovwa",
            "email": "stanwafi@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "saloonphp/laravel-plugin": "^4.3",
        "saloonphp/pagination-plugin": "^2.3",
        "saloonphp/rate-limit-plugin": "^2.5",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Prodstarter\\FilamentForgeInsights\\": "src/",
            "Prodstarter\\FilamentForgeInsights\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Prodstarter\\FilamentForgeInsights\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@php ./vendor/bin/testbench package:discover --ansi"
        ],
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Prodstarter\\FilamentForgeInsights\\FilamentForgeInsightsServiceProvider"
            ],
            "aliases": {
                "FilamentForgeInsights": "Prodstarter\\FilamentForgeInsights\\Facades\\FilamentForgeInsights"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
